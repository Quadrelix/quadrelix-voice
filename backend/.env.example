PORT=3000

# Optional — leave blank to use the offline regex parser (works immediately, no signup needed)
# Get a free key at https://aistudio.google.com/apikey to use the smarter multi-item
# LLM parser instead. The Flash models have a no-cost free tier.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.7-flash. Set gemini-3.5-flash-lite for lower cost.
GEMINI_MODEL=

# Required for voice input — get a free key at https://www.sarvam.ai
SARVAM_API_KEY=

# Leave blank to keep WhatsApp sending in "simulated" mode (logs to console only)
# Set to "twilio" once you've added the credentials below. ("gupshup" and "meta"
# are recognised but not implemented yet — see services/whatsapp.js)
WHATSAPP_PROVIDER=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Required when WHATSAPP_PROVIDER=twilio. Twilio's servers fetch the bill image
# from a URL you give them, so it must be publicly reachable — they cannot reach
# localhost or a 192.168.x.x address. Run `ngrok http 3000` and paste the
# https:// URL it prints here, with no trailing slash.
PUBLIC_BASE_URL=
