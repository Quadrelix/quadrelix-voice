PORT=3000

# Optional — leave blank to use the offline regex parser (works immediately, no signup needed)
# Get a key from https://console.anthropic.com to use the smarter LLM parser instead
ANTHROPIC_API_KEY=

# Leave blank to keep WhatsApp sending in "simulated" mode (logs to console only)
# Set to "twilio" | "gupshup" | "meta" once you've signed up and implemented the TODO in services/whatsapp.js
WHATSAPP_PROVIDER=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
