# Copy to mobile-app/.env (never commit it) ONLY when you want the app to talk to a
# backend running on your own laptop instead of the live one.
#
# Use your laptop's Wi-Fi IPv4 address (run `ipconfig` and read "IPv4 Address"), not
# "localhost": the phone is a different device. Phone and laptop must be on the same Wi-Fi.
#   EXPO_PUBLIC_API_URL=http://192.168.1.5:3000
#
# Leave this file out (or the line commented) to use the live Render backend.
# After changing it, restart Expo with:  npx expo start --go --clear
