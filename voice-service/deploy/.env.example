# Copy to .env on the VM (never commit .env).
# Public hostname that points at the VM, e.g. voice-1-2-3-4.sslip.io or mything.duckdns.org
DOMAIN=
# Shared secret; generate with:  openssl rand -hex 24
# Put the SAME value in Render as VOICE_SERVICE_TOKEN.
VOICE_SERVICE_TOKEN=
# Optional overrides (defaults shown)
# VOICE_THRESHOLD=0.30
# VOICE_MIN_SECONDS=1.5
